# Workerra environment — copy to .env.local for development.
# Never commit real values. In int/test/acc/prod, secrets come from WSL Vault
# (workerra/<ring>/<name>) via External Secrets, as JobShout does.

# Ring: local | int | test | acc | prod. Controls site URL defaults, log level
# and whether search engines may index the site (prod only).
APP_ENV=local

# Public base URL, read on the server at request time. Defaults per ring
# (int → https://int.workerra.uk, prod → https://www.workerra.uk). Not NEXT_PUBLIC_*:
# that would bake one ring's URL into the image promoted to every ring.
SITE_URL=http://localhost:3020

# debug | info | warn | error (default: debug, info in prod)
LOG_LEVEL=debug

# Dev server port (npm run dev)
PORT=3020

# --- Assistant ---
# NebulaDB AI chat (/api/v1/ai/chat), the service behind the JobShout recruiting
# bot. Unset → the assistant runs in guided mode: built-in answers and links for
# the five journeys, no LLM. That is all local development needs. In the cluster this is the ring's
# NebulaDB, e.g. http://nebuladb.int.svc.cluster.local:8080. Locally, run a
# nebula-server with NEBULA_LLM_OLLAMA_URL set (see docs/chatbot-reference.md).
# Server only: never expose these through NEXT_PUBLIC_*.
NEBULA_URL=
# Bearer key, only if that NebulaDB sets NEBULA_API_KEYS.
NEBULA_API_KEY=

# Recruitment team inbox the assistant offers when someone asks to contact the
# team (shown to visitors as a mailto: link). Unset → the assistant says there is
# no contact channel yet. Not a secret, but set per ring at runtime.
CONTACT_EMAIL=

# OpsAPI: job listings, applications and recruiter sign-in (ATS jobs published
# through Workerra's plugin, migrations/opsapi/). All three set → /jobs, job pages,
# applying and /recruiters work against it; any unset → the pages say listings
# aren't live. Workerra uses its own namespace, never JobShout's. The server's
# opsk_ key needs only workerra_jobs: ["read", "create"] (search and apply);
# recruiters act with their own sign-in. ./start.sh starts a local OpsAPI and
# fills these in (see migrations/opsapi/README.md).
OPSAPI_URL=
OPSAPI_NAMESPACE=workerra
OPSAPI_API_KEY=

# Encrypts the recruiter session cookie (32+ characters: openssl rand -hex 32).
# Unset → recruiter sign-in is off. In the rings it comes from Vault
# (workerra/<ring>/core). ./start.sh generates one.
SESSION_SECRET=

# Local OpsAPI only (docker-compose.opsapi.yml; ./start.sh fills these in): the
# recruiter account the bootstrap creates, and the sign-in code OpsAPI accepts in
# place of an emailed one (there's no mail server locally).
WORKERRA_RECRUITER_EMAIL=
WORKERRA_RECRUITER_PASSWORD=
OPSAPI_TEST_OTP_CODE=

# JobShout agent platform (Career Agent: CV tailoring, cover letters). Phase 4.
JOBSHOUT_API_URL=
