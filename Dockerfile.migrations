# Workerra's OpsAPI plugin image: the public OpsAPI image plus this repo's
# migrations/opsapi/ at /app/projects/workerra/, where OpsAPI's plugin runner
# finds it. Same pattern as bwalia/diy-tax-return-uk Dockerfile.migrations.
#
# Run as a Helm pre-upgrade hook (after OpsAPI's own migrations) with:
#   lapis exec "require('helper.project-migrator').migrate('workerra', '/app/projects/workerra')"
#
# OPSAPI_TAG pins the base, e.g. to the version the target ring's OpsAPI runs.
ARG OPSAPI_TAG=latest
FROM docker.io/bwalia/opsapi:${OPSAPI_TAG}

COPY migrations/opsapi/project.lua  /app/projects/workerra/project.lua
COPY migrations/opsapi/migrations   /app/projects/workerra/migrations

# Fail the build, not the deploy, if the runner couldn't find the files.
RUN test -f /app/projects/workerra/project.lua \
 && ls /app/projects/workerra/migrations/*.lua > /dev/null

# Base image entrypoint kept, so `docker run --rm <image> lapis exec ...` works.
