{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/modules/*/*", "!@/modules/*/index"],
            "message": "Import a module through its public index (e.g. '@/modules/jobs'), not its internals."
          }
        ]
      }
    ]
  }
}
